{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode development --open",
    "build:test": "run-p type-check \"build-only-test {@}\" --",
    "build:prod": "run-p type-check \"build-only-prod {@}\" --",
    "build:pclocal": "run-p type-check \"build-only-pclocal {@}\" --",
    "build-only-test": "vite build --mode test",
    "build-only-prod": "vite build --mode product",
    "build-only-pclocal": "vite build --mode pclocal",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "axios": "^1.13.2",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.8",
    "js-cookie": "^3.0.5",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.3",
    "postcss-pxtorem": "^6.1.0",
    "sass": "^1.89.2",
    "ts-md5": "^2.0.1",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^30.0.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "npm-run-all2": "^8.0.4",
    "postcss-nesting": "^13.0.2",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "unocss": "^66.5.7",
    "unplugin-element-plus": "^0.11.1",
    "vite": "^7.1.11",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vue-tsc": "^3.1.1"
  }
}
